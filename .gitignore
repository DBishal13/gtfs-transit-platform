app/public/data/

# Pipeline build output (regenerated, never committed)
data/build/
data/raw/*/census/
!data/raw/*/census/.gitkeep

# External toolchain fetched at CI/dev time
.tools/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env
.env
