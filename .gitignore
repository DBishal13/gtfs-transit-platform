# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
.ruff_cache/
.mypy_cache/

# Node / frontend
node_modules/
app/dist/
app/.vite/
*.local

# Real/generated data the app reads locally — populated from app/public/data-sample/
