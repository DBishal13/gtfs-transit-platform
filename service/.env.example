# Copy to service/.env for local dev. Every setting has a working default for the
# docker-compose Postgres already used by pipeline/postgis/ — you only need to override
# values here once you touch auth (Phase 2+), the LLM agent (Phase 4+), or geocoding
# (Phase 3+).

DATABASE_URL=postgresql://transit:transit@localhost:5432/transit
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Auth (Phase 2+) — generate a real secret before any non-local deployment.
JWT_SECRET_KEY=dev-insecure-secret-change-me

# LLM agent (Phase 4+) — pick one provider.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Geocoding (Phase 3+) — Nominatim's public instance needs no key but has a strict usage
# policy; set NOMINATIM_BASE_URL to a self-hosted instance for anything beyond light dev use.
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
