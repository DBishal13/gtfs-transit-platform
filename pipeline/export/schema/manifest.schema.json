{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "manifest.json",
  "type": "object",
  "required": ["schema_version", "generated_at", "feeds"],
  "properties": {
    "schema_version": { "type": "integer" },
    "generated_at": { "type": "string" },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "region", "source_url", "license", "bbox", "counts", "assets", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "source_url": { "type": "string" },
          "license": { "type": "string" },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "counts": {
            "type": "object",
            "required": ["routes", "stops", "trips"],
            "properties": {
              "routes": { "type": "integer" },
              "stops": { "type": "integer" },
              "trips": { "type": "integer" }
            }
          },
          "assets": {
            "type": "object",
            "required": ["routes_summary", "headway", "coverage", "quality", "routes_geojson", "stops_geojson"],
            "properties": {
              "routes_summary": { "type": "string" },
              "headway": { "type": "string" },
              "coverage": { "type": "string" },
              "quality": { "type": "string" },
              "spacing": { "type": "string" },
              "duplication": { "type": "string" },
              "schedule_span": { "type": "string" },
              "routes_geojson": { "type": "string" },
              "stops_geojson": { "type": "string" },
              "tiles": { "type": ["string", "null"] },
              "stop_times_parquet": { "type": ["string", "null"] }
            }
          },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
